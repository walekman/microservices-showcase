{
  "realm": "showcase",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginTheme": "bank-ui",
  "roles": {
    "realm": [
      {
        "name": "transfer-executor",
        "description": "Can initiate and view transfers"
      },
      {
        "name": "account-reader",
        "description": "Can list/get accounts"
      },
      {
        "name": "account-editor",
        "description": "Can create accounts and debit (a customer only their own account; see account-crediter for credit)"
      },
      {
        "name": "account-crediter",
        "description": "Can credit any account -- held only by transfer-service's machine identity, never by the customer composite"
      },
      {
        "name": "fraud-checker",
        "description": "Can invoke the fraud-check endpoint"
      },
      {
        "name": "account-admin",
        "description": "Can list every account (GET /accounts) -- not part of the customer composite"
      },
      {
        "name": "transfer-admin",
        "description": "Can list every transfer (GET /transfers) -- not part of the customer composite"
      },
      {
        "name": "customer",
        "description": "Composite role for a real end user: bundles every capability a human caller needs",
        "composite": true,
        "composites": {
          "realm": ["transfer-executor", "account-reader", "account-editor", "fraud-checker"]
        }
      },
      {
        "name": "default-roles-showcase",
        "description": "Assigned automatically to every new user, including self-registered ones",
        "composite": true,
        "composites": { "realm": ["customer"] }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-showcase",
    "composite": true,
    "composites": { "realm": ["customer"] }
  },
  "clients": [
    {
      "clientId": "showcase-ui",
      "name": "Showcase UI",
      "description": "Represents any human caller: the Bank UI (Authorization Code + PKCE) and curl/Postman (password grant)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8090/"],
      "webOrigins": ["http://localhost:8090"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/"
      }
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer Service",
      "description": "Transfer Service's own machine identity, used only when there is no inbound user request to relay a token from",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "transfer-service-secret"
    }
  ],
  "users": [
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@showcase.example",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["customer"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@showcase.example",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["customer"]
    },
    {
      "username": "service-account-transfer-service",
      "enabled": true,
      "serviceAccountClientId": "transfer-service",
      "realmRoles": ["account-editor", "fraud-checker", "account-crediter"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@showcase.example",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["account-admin", "transfer-admin"]
    }
  ]
}
