{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Min|Max|Avg|P90)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Service|Request)$"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "pattern": "^\"(.*)\"$",
                      "result": {
                        "text": "$1"
                      }
                    },
                    "type": "regex"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Count"
          }
        ],
        "zebraStriping": false
      },
      "pluginVersion": "13.3.2",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "hide": true,
          "metricsQueryType": "instant",
          "query": "{name=~\"http get .*\" && name !~ \".*/actuator/.*\"} | count_over_time() by (resource.service.name, name)",
          "queryType": "traceql",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "hide": true,
          "metricsQueryType": "instant",
          "query": "{name=~\"http get .*\" && name !~ \".*/actuator/.*\"} | min_over_time(duration) by (resource.service.name, name)",
          "queryType": "traceql",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "hide": true,
          "metricsQueryType": "instant",
          "query": "{name=~\"http get .*\" && name !~ \".*/actuator/.*\"} | max_over_time(duration) by (resource.service.name, name)",
          "queryType": "traceql",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "hide": true,
          "metricsQueryType": "instant",
          "query": "{name=~\"http get .*\" && name !~ \".*/actuator/.*\"} | avg_over_time(duration) by (resource.service.name, name)",
          "queryType": "traceql",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "hide": true,
          "metricsQueryType": "instant",
          "query": "{name=~\"http get .*\" && name !~ \".*/actuator/.*\"} | quantile_over_time(duration, .9) by (resource.service.name, name)",
          "queryType": "traceql",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$A",
          "refId": "Count",
          "type": "math"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$B",
          "refId": "Min",
          "type": "math"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$C",
          "refId": "Max",
          "type": "math"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$D",
          "refId": "Avg",
          "type": "math"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$E",
          "refId": "P90",
          "type": "math"
        }
      ],
      "title": "HTTP GET requests by service",
      "transformations": [
        {
          "filter": {
            "id": "byRefId",
            "options": "Count"
          },
          "id": "reduce",
          "options": {
            "labelsToFields": true,
            "mode": "seriesToRows",
            "reducers": [
              "sum"
            ]
          }
        },
        {
          "filter": {
            "id": "byRefId",
            "options": "Min"
          },
          "id": "reduce",
          "options": {
            "labelsToFields": true,
            "mode": "seriesToRows",
            "reducers": [
              "min"
            ]
          }
        },
        {
          "filter": {
            "id": "byRefId",
            "options": "Max"
          },
          "id": "reduce",
          "options": {
            "labelsToFields": true,
            "mode": "seriesToRows",
            "reducers": [
              "max"
            ]
          }
        },
        {
          "filter": {
            "id": "byRefId",
            "options": "Avg"
          },
          "id": "reduce",
          "options": {
            "labelsToFields": true,
            "mode": "seriesToRows",
            "reducers": [
              "mean"
            ]
          }
        },
        {
          "filter": {
            "id": "byRefId",
            "options": "P90"
          },
          "id": "reduce",
          "options": {
            "labelsToFields": true,
            "mode": "seriesToRows",
            "reducers": [
              "last"
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(name|resource\\.service\\.name|Total|Min|Max|Mean|Last)$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Last": 5,
              "Max": 6,
              "Mean": 4,
              "Min": 3,
              "Total": 2,
              "name": 1,
              "resource.service.name": 0
            },
            "renameByName": {
              "Last": "P90",
              "Mean": "Avg",
              "Total": "Count",
              "name": "Request",
              "resource.service.name": "Service"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Count"
              }
            ]
          }
        }
      ],
      "type": "table",
      "description": "Five hidden instant TraceQL queries (A-E), each re-exposed by a Math expression named after its column. Tempo frames carry no query refId, so the expressions are what let transformations target one query. Each expression is then reduced with a different reducer (sum/min/max/mean/last; all no-ops on one value) only to give its column a distinct field name, because Merge matches on field names and ignores renames. P90 is approximate: Tempo buckets quantiles in powers of two."
    }
  ],
  "preload": false,
  "refresh": "",
  "schemaVersion": 42,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "Microservices Showcase — Request Stats",
  "uid": "showcase-request-stats",
  "description": "Per service and HTTP GET span name: call count and min/avg/p90/max duration over the selected range, from Tempo TraceQL metrics (instant queries)."
}
